# Copie pra .env (gitignored) e preencha com as chaves do projeto Supabase real.
# Sem essas duas vars, o app roda em modo local (ver src/ctx.tsx) — login/cadastro
# funcionam só pra navegar o app, sem autenticação nem persistência de verdade.
#
# Onde achar: painel do Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
